# Yeni Form — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env.local  → değerleri doldur

# ── Supabase ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ─────────────────────────────────────────────────
VITE_SITE_URL=https://www.yeniform.com
APP_URL=https://www.yeniform.com

# ── Güvenlik (API guard — production zorunlu) ────────────
# Aynı değeri hem sunucu hem client'a yazın:
TELEGRAM_NOTIFY_SECRET=57411e0f50ff453694271072d1e697978bf674146e7ddca190da1a109394e3e0
VITE_TELEGRAM_NOTIFY_SECRET=57411e0f50ff453694271072d1e697978bf674146e7ddca190da1a109394e3e0

# Opsiyonel: API / istemci admin e-posta override (varsayılan admin@yeniform.com)
# ADMIN_EMAIL=admin@yeniform.com
# VITE_ADMIN_EMAIL=admin@yeniform.com

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONTACT_CHAT_ID=
TELEGRAM_STAFF_APPLICATION_CHAT_ID=-5498651592
TELEGRAM_CORPORATE_APPLICATION_CHAT_ID=-5101124711
# Ödeme bildirimleri (Stripe başarılı/başarısız). Boşsa TELEGRAM_CHAT_ID'ye düşer.
TELEGRAM_PAYMENT_CHAT_ID=

# ── AI (Gemini) ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
VITE_AI_VISION_ENABLED=true
VITE_AI_CHAT_ENABLED=true

# Günlük blog cron (08:00 Türkiye = 05:00 UTC)
CRON_SECRET=

# ── Stripe ───────────────────────────────────────────────
# Ücretli paketler yalnızca Stripe Checkout (test kartı UI kaldırıldı)
VITE_STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Daily.co (video görüşme) ─────────────────────────────
DAILY_API_KEY=
VITE_DAILY_DOMAIN=yeniform.daily.co
VITE_DAILY_ROOM_PREFIX=donusum
VITE_VIDEO_JOIN_MINUTES_BEFORE=15
VITE_VIDEO_JOIN_MINUTES_AFTER=30

# ── Opsiyonel ────────────────────────────────────────────
VITE_PHONE_VERIFY_ENABLED=false
VITE_PHONE_VERIFY_VIA_EMAIL=true
VITE_GA4_MEASUREMENT_ID=G-40ENH7MC5W
