# Supabase bağlantısı (Vercel + yerel .env)
# Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# veya: VITE_SUPABASE_ANON_KEY=eyJ...

# Site URL (SEO — canonical, sitemap, Open Graph)
# Production domain (sonunda / olmadan):
VITE_SITE_URL=https://www.yeniform.com
APP_URL=https://www.yeniform.com
# Google Search Console doğrulama kodu (opsiyonel — DNS ile doğrulandıysa gerekmez):
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# Google Analytics 4 — Measurement ID (analytics.google.com → Veri akışı → G-XXXXXXXXXX)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sosyal medya (JSON-LD sameAs) — hesabınız yoksa o satırı atlayın
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/kullaniciadi
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/sayfaadi
# VITE_SOCIAL_LINKEDIN=https://www.linkedin.com/company/yeniform
# VITE_SOCIAL_X=https://x.com/kullaniciadi
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@kanal

# -----------------------------------------------------------------------
# Yerel test için vercel dev kullanın veya .env.local dosyası oluşturun.
# -----------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=123456789          ← giriş/kayıt bildirimleri
# TELEGRAM_CONTACT_CHAT_ID=987654321  ← Bize Ulaşın formu (ayrı chat)

# İsteğe bağlı spam koruması (ikisi de aynı rastgele değer olmalı):
# TELEGRAM_NOTIFY_SECRET=uzun-rastgele-string
# VITE_TELEGRAM_NOTIFY_SECRET=uzun-rastgele-string

# -----------------------------------------------------------------------
# AI — Google Gemini (EN UCUZ + ücretsiz katman). Detay: AI_SETUP.md
# Anahtarı SADECE Vercel Environment Variables'a ekleyin (VITE_ OLMADAN!).
# Ücretsiz anahtar: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...                  ← SUNUCU tarafı (gizli)
# GEMINI_MODEL=gemini-2.0-flash             ← opsiyonel (varsayılan bu)

# Arayüzün gerçek AI denemesini açan bayraklar (anahtar değil, sadece on/off):
# VITE_AI_VISION_ENABLED=true               ← Fotoğraflı + chat kalori analizi
# VITE_AI_NUTRITION_ENABLED=true            ← AI destekli beslenme notu

# -----------------------------------------------------------------------
# Daily.co Video Görüşme (https://dashboard.daily.co)
# Domain: yeniform.daily.co
# -----------------------------------------------------------------------
VITE_DAILY_DOMAIN=yeniform.daily.co
VITE_DAILY_ROOM_PREFIX=donusum
# Production güvenli mod — oda oluşturma + token (bkz. VIDEO_SETUP.md):
# DAILY_API_KEY=your_daily_api_key    ← SUNUCU tarafı (gizli, VITE_ yok!)
# VITE_AI_FOOD_ENABLED=true          ← (KALDIRILDI) eski custom_foods otomatik kayıt
# Randevu penceresi (dakika):
# VITE_VIDEO_JOIN_MINUTES_BEFORE=15
# VITE_VIDEO_JOIN_MINUTES_AFTER=30

# -----------------------------------------------------------------------
# Stripe Ödeme (gerçek ödeme altyapısı). Detay: STRIPE_SETUP.md
# Gizli anahtarlar SADECE Vercel Environment Variables'a (VITE_ OLMADAN!).
# -----------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx              ← SUNUCU tarafı (gizli)
# STRIPE_WEBHOOK_SECRET=whsec_xxx            ← Webhook imza doğrulama (gizli)
# Webhook'un üyeliği aktifleştirebilmesi için service-role anahtarı gerekir:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...           ← SUNUCU tarafı (GİZLİ! RLS atlar)
# SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co   ← (VITE_SUPABASE_URL de kabul edilir)
# APP_URL=https://siteniz.com                ← başarı/iptal yönlendirmesi (opsiyonel)

# Arayüzde Stripe ödeme akışını açan bayrak (gizli değil, sadece on/off):
# VITE_STRIPE_ENABLED=true
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx    ← opsiyonel (redirect akışında zorunlu değil)

# Yalnızca yerel webhook testinde imza doğrulamasını atlamak için (ASLA production'da!):
# STRIPE_WEBHOOK_DEV_BYPASS=true
