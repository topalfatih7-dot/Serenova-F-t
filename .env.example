# Yeni Form — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env.local  → değerleri doldur

# ── Supabase ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ─────────────────────────────────────────────────
VITE_SITE_URL=https://www.yeniform.com
APP_URL=https://www.yeniform.com
# Google Search Console HTML meta doğrulama token’ı (DNS TXT yoksa). Build’de index.html’e enjekte edilir.
# VITE_GSC_VERIFICATION=

# ── Güvenlik (API guard — production zorunlu) ────────────
# Cloudflare Turnstile: production'da VITE_TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY
# Localhost (npm run dev): bot kontrolü otomatik atlanır; ek anahtar gerekmez.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=
# İsteğe bağlı zorla: ALLOW_LOCAL_AUTH_BYPASS=1 | 0

# Aynı değeri hem sunucu hem client'a yazın (uzun rastgele secret üretin):
TELEGRAM_NOTIFY_SECRET=
VITE_TELEGRAM_NOTIFY_SECRET=

# Opsiyonel: API / istemci admin e-posta override (varsayılan admin@yeniform.com)
# ADMIN_EMAIL, VITE_ADMIN_EMAIL ve DB platform_settings.admin_email AYNI olmalı.
# ADMIN_EMAIL=admin@yeniform.com
# VITE_ADMIN_EMAIL=admin@yeniform.com

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONTACT_CHAT_ID=
TELEGRAM_STAFF_APPLICATION_CHAT_ID=
TELEGRAM_CORPORATE_APPLICATION_CHAT_ID=
# Ödeme bildirimleri (Stripe başarılı/başarısız). Boşsa TELEGRAM_CHAT_ID'ye düşer.
TELEGRAM_PAYMENT_CHAT_ID=


# ── AI OpenAI (kalori GPT-4o + staff sağlık GPT-5.4) ──
# Sunucu tarafı — VITE_ öneki YOK. Boş bırakırsanız OpenAI uçları çalışmaz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_HEALTH_MODEL=gpt-5.4

# ── AI Blog / ipucu (Gemini) ─────────────────────────────
# Gemini yalnızca blog/ipucu metni.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
VITE_AI_VISION_ENABLED=true
VITE_AI_CHAT_ENABLED=true

# Günlük blog cron (08:00 Türkiye = 05:00 UTC)
CRON_SECRET=

# ── Stripe ───────────────────────────────────────────────
# Ücretli paketler yalnızca Stripe Checkout (test kartı UI kaldırıldı)
VITE_STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Daily.co (video görüşme) ─────────────────────────────
DAILY_API_KEY=
VITE_DAILY_DOMAIN=yeniform.daily.co
VITE_DAILY_ROOM_PREFIX=donusum
# Katılma penceresi (dk): önce / süre bitiminden sonra — sektör varsayılanları
# koç 10/20 · diyetisyen 15/30 · doktor 15/30
# VITE_VIDEO_JOIN_BEFORE_COACH=10
# VITE_VIDEO_JOIN_AFTER_COACH=20
# VITE_VIDEO_JOIN_BEFORE_DIETITIAN=15
# VITE_VIDEO_JOIN_AFTER_DIETITIAN=30
# VITE_VIDEO_JOIN_BEFORE_DOCTOR=15
# VITE_VIDEO_JOIN_AFTER_DOCTOR=30
# Sunucu (Vercel) aynı değerler için VIDEO_JOIN_BEFORE_COACH vb. de okunur.

# ── E-posta (Resend) ─────────────────────────────────────
# Detay: docs/OPS_RESEND_MAIL.md
# Ücretsiz: 3.000 mail/ay — personel onay/red + (Supabase SMTP ile) auth mailleri
RESEND_API_KEY=re_...
MAIL_FROM=Yeni Form <info@yeniform.com>

# ── Opsiyonel ────────────────────────────────────────────
VITE_PHONE_VERIFY_ENABLED=false
VITE_PHONE_VERIFY_VIA_EMAIL=true
VITE_GA4_MEASUREMENT_ID=G-40ENH7MC5W

# ── WhatsApp Business Cloud API (Meta) ───────────────────
# Detay: docs/OPS_WHATSAPP.md — şablon onayı + webhook zorunlu
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v22.0
