# Supabase bağlantısı
# Bu dosyayı ".env" olarak kopyalayın ve Supabase projenizdeki değerlerle doldurun.
# Supabase Dashboard > Project Settings > API sayfasından alabilirsiniz.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Yeni "publishable" anahtar (önerilen): sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Veya eski "anon public" anahtarı (JWT, eyJ... ile başlar) — yalnızca biri yeterli:
# VITE_SUPABASE_ANON_KEY=eyJ...
