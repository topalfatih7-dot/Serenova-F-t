# Supabase bağlantısı (Vercel + yerel .env)
# Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# veya: VITE_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------
# Telegram — Vercel Environment Variables'a ekleyin (VITE_ OLMADAN token!)
# Yerel test için vercel dev kullanın veya .env.local dosyası oluşturun.
# -----------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=123456789

# İsteğe bağlı spam koruması (ikisi de aynı rastgele değer olmalı):
# TELEGRAM_NOTIFY_SECRET=uzun-rastgele-string
# VITE_TELEGRAM_NOTIFY_SECRET=uzun-rastgele-string
