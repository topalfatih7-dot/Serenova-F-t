{
  "buildCommand": "npm run build",
  "devCommand": "vite --port 5173",
  "framework": "vite",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.asp", "destination": "/", "permanent": true },
    { "source": "/Index.asp", "destination": "/", "permanent": true },
    { "source": "/team/doctors", "destination": "/hakkimizda", "permanent": true },
    { "source": "/team/doktor-:slug*", "destination": "/hakkimizda", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/ai-blog-generate?task=membership-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/ai-blog-generate?task=daily-tip",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/ai-blog-generate",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/ai-blog-generate?task=session-attendance",
      "schedule": "20 2 * * *"
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Google-InspectionTool|bingbot|BingPreview).*"
        }
      ],
      "destination": "/api/sitemap?shell=blog&slug=:slug"
    },
    {
      "source": "/team/koc-:rest",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Google-InspectionTool|bingbot|BingPreview).*"
        }
      ],
      "destination": "/api/sitemap?shell=team&slug=koc-:rest"
    },
    {
      "source": "/team/diyetisyen-:rest",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(Googlebot|Google-InspectionTool|bingbot|BingPreview).*"
        }
      ],
      "destination": "/api/sitemap?shell=team&slug=diyetisyen-:rest"
    },
    { "source": "/indir", "destination": "/indir.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
